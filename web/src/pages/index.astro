---
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Commish</title>
  </head>
  <body class="bg-neutral-950 text-neutral-100 font-sans">
    <main class="mx-auto max-w-3xl p-4 space-y-6">
      <header>
        <h1 class="text-2xl font-semibold">Commish</h1>
        <p class="text-neutral-400 text-sm">Affiliate commissions locked on-chain until the refund window closes, then paid automatically. Creators can sell a pending commission today.</p>
        <p id="meta" class="text-xs text-neutral-500 font-mono break-all mt-2">Loading…</p>
      </header>

      <section class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="stats"></section>

      <form id="buy" class="flex gap-2 items-end">
        <label class="flex flex-col text-sm">Order amount (USDC)
          <input name="amount" type="number" min="1" step="0.01" value="120" class="mt-1 rounded bg-neutral-900 border border-neutral-700 px-3 py-2 font-mono tabular-nums" />
        </label>
        <button class="rounded bg-emerald-600 hover:bg-emerald-500 px-4 py-2 focus-visible:ring-2 focus-visible:ring-emerald-300">Customer buys</button>
      </form>

      <p id="msg" class="text-sm min-h-5" role="status"></p>

      <section>
        <h2 class="font-semibold mb-2">Orders</h2>
        <div id="orders" class="space-y-2"></div>
      </section>
    </main>

    <script>
      const $ = (id: string) => document.getElementById(id)!;
      const usd = (n: number) => "$" + n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const msg = (t: string, bad = false) => { $("msg").textContent = t; $("msg").className = "text-sm min-h-5 " + (bad ? "text-red-400" : "text-emerald-400"); };

      async function call(action: string, body: object) {
        msg("Sending…");
        const r = await fetch("/api/" + action, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
        const j = await r.json();
        if (j.error) msg(j.error, true); else msg("Confirmed " + j.signature.slice(0, 16) + "…");
        await load();
      }
      (window as any).act = call;

      const stat = (k: string, v: string) => `<div class="rounded border border-neutral-800 p-3"><div class="text-xs text-neutral-400">${k}</div><div class="font-mono tabular-nums">${v}</div></div>`;

      async function load() {
        const r = await fetch("/api/state");
        const s = await r.json();
        if (s.error) { $("meta").textContent = s.error; return; }
        $("meta").textContent = `program ${s.program} · campaign ${s.campaign} · ${s.commissionPct}% commission · ${s.holdSeconds}s refund window · ${s.rpc}`;
        $("stats").innerHTML = [
          stat("Vault", usd(s.budget.vault)), stat("Reserved", usd(s.budget.reserved)),
          stat("Free budget", usd(s.budget.free)), stat("Paid out", usd(s.budget.paid)),
          stat("Creator pending", usd(s.creator.pending)), stat("Creator earned", usd(s.creator.earned)),
          stat("Creator wallet", usd(s.creator.usdc)), stat("Early-payout desk", usd(s.desk.usdc)),
        ].join("");
        $("orders").innerHTML = s.orders.length ? s.orders.map((o: any) => {
          const pending = o.status === "Pending";
          const btn = (a: string, label: string, on = true) => `<button ${on ? "" : "disabled"} onclick="act('${a}',{order:'${o.id}'})" class="rounded border border-neutral-700 px-3 py-1 text-sm hover:bg-neutral-800 disabled:opacity-40">${label}</button>`;
          return `<div class="rounded border border-neutral-800 p-3 flex flex-wrap gap-2 items-center justify-between">
            <div><a class="font-mono text-sm underline" target="_blank" rel="noopener" href="https://explorer.solana.com/address/${o.account}?cluster=devnet">order ${o.id.slice(0, 8)}</a>
              <div class="text-xs text-neutral-400 tabular-nums">order ${usd(o.amount)} · commission ${usd(o.commission)} · ${o.status}${o.soldToDesk ? " (sold to desk)" : ""}${pending && o.secondsLeft ? ` · releases in ${o.secondsLeft}s` : ""}</div></div>
            <div class="flex gap-2">${pending ? btn("refund", "Refund") + btn("cashout", `Cash out now (−${s.deskFeePct}%)`, !o.soldToDesk) + btn("release", "Release", o.secondsLeft === 0) : ""}</div>
          </div>`;
        }).join("") : `<p class="text-sm text-neutral-400">No orders yet. Record a sale above.</p>`;
      }

      $("buy").addEventListener("submit", (e) => {
        e.preventDefault();
        call("buy", { amount: Number(new FormData(e.target as HTMLFormElement).get("amount")) });
      });
      load();
      setInterval(load, 3000);
    </script>
  </body>
</html>
